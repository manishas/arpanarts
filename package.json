{
  "name": "arpanarts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tinacms dev -c \"next dev\"",
    "build": "tinacms build && next build",
    "build:local": "tinacms build --local --skip-cloud-checks -c \"NODE_ENV=production next build\"",
    "start": "npx serve out"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tinacms": "^3.15.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tinacms/cli": "^4.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
